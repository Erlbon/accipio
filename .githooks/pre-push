#!/bin/sh
# Test gate: the Python tests must pass before anything is pushed (until tests exist there is nothing to run).
# Runs in the repo's own .venv when there is one (it holds the pinned redactor_common); the shared Python's copy may be
# older (2026-11-07: the release tool's tag push failed on an old redactor_common there).
PY=python
[ -x .venv/Scripts/python.exe ] && PY=.venv/Scripts/python.exe
[ -x .venv/bin/python ] && PY=.venv/bin/python
if [ -d tests ]; then
  QT_QPA_PLATFORM=offscreen "$PY" -m pytest tests -q || { echo "pre-push: the Python tests fail; not pushing" >&2; exit 1; }
fi
exit 0
